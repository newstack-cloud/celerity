# =============================================================================
# Celerity Core Runtime — Environment Variables
# =============================================================================

# --- Required ---

# Path to the blueprint YAML file defining API routes and handler metadata.
CELERITY_BLUEPRINT=./app/blueprint.yaml

# Path to the compiled handlers executable that the runtime starts and streams
# events to. The runtime exits if it cannot be started.
CELERITY_HANDLERS_EXECUTABLE=./app/handlers

# Service name used for logging and distributed tracing.
CELERITY_SERVICE_NAME=my-service

# HTTP server port.
CELERITY_SERVER_PORT=8080

# Deployment platform: aws, azure, gcp, local, or other.
CELERITY_RUNTIME_PLATFORM=local

# Runtime call mode. Must be "ipc" for the core runtime; it has no in-process
# handlers to call. Defaults to "ipc" in the Docker image.
CELERITY_RUNTIME_CALL_MODE=ipc

# --- Handlers executable ---

# Arguments passed to the handlers executable, split on whitespace.
# CELERITY_HANDLERS_ARGS=--verbose

# Directory the handlers executable is started in. The runtime's own working
# directory when unset.
# CELERITY_HANDLERS_WORKING_DIR=./app

# Seconds between SIGTERM and SIGKILL for the handlers executable on shutdown.
# This covers the executable's own teardown; CELERITY_DRAIN_TIMEOUT covers the
# in-flight events it still owes results for. Defaults to 30.
# CELERITY_HANDLERS_SHUTDOWN_TIMEOUT=30

# Seconds the handlers executable has to attach to the handler stream before the
# runtime gives up and exits non-zero. A process that starts but never attaches
# never exits, so without this it looks healthy while every event is shed.
# Set to 0 to wait indefinitely. Defaults to 60.
# CELERITY_HANDLERS_START_TIMEOUT=60

# --- Handler stream (IPC) ---

# Unix socket the handler stream is served on. The handlers executable connects
# to this; a Celerity SDK reads the same variable.
# CELERITY_RUNTIME_SOCKET=/var/run/celerity/runtime.sock

# Serve the handler stream over loopback TCP when the unix socket cannot be
# bound. Any process that can reach loopback can then register as a handler, so
# this is off by default.
# CELERITY_RUNTIME_SOCKET_FALLBACK_ENABLED=false
# CELERITY_RUNTIME_SOCKET_FALLBACK_PORT=8592

# Seconds the runtime waits for in-flight events to come back over the stream
# on shutdown. Derived from the configured handler timeouts when unset.
# CELERITY_DRAIN_TIMEOUT=30

# --- Optional ---

# Bind to loopback (127.0.0.1) only. Set to false in Docker containers.
# CELERITY_SERVER_LOOPBACK_ONLY=true

# Runtime diagnostics level: trace, debug, info, warn, error. Defaults to info.
# CELERITY_MAX_DIAGNOSTICS_LEVEL=info

# Log format: json or text.
# CELERITY_LOG_FORMAT=json

# --- Telemetry ---

# OTLP collector endpoint for trace export.
# CELERITY_TRACE_OTLP_COLLECTOR_ENDPOINT=http://otelcollector:4317

# Emit OpenTelemetry metrics. Defaults to false.
# CELERITY_METRICS_ENABLED=false

# Ratio of traces sampled, from 0.0 to 1.0.
# CELERITY_TRACE_SAMPLE_RATIO=1.0

# --- Advanced ---

# Disable the default /runtime/health/check endpoint.
# CELERITY_USE_CUSTOM_HEALTH_CHECK=true

# Client IP detection source. Default: ConnectInfo.
# Options: ConnectInfo, XForwardedFor, XRealIp, Forwarded, TrueClientIp, CFConnectingIp
# CELERITY_CLIENT_IP_SOURCE=ConnectInfo

# Cache TTL in seconds for the runtime resource store (JWT keys, OIDC discovery).
# CELERITY_RESOURCE_STORE_CACHE_ENTRY_TTL=600

# TLS verification for resource store HTTP requests.
# CELERITY_RESOURCE_STORE_VERIFY_TLS=true
