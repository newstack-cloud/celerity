# Code generated pre-build, (e.g genny generics templates)
gen-*.go

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# The compiled sidecar. `go build` with no -o writes it here under the module
# basename, so it lands next to the source rather than in a build directory.
/local-events

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.txt
coverage.html
coverage

# Test report for sonar.
report.json

# Dependency directories (remove the comment below to include it)
vendor/

# Any log files.
*.log

# Test shell scripts for manually testing the CLI
# in non-interactive mode.
test-*.sh

!.env.test

.claude
CLAUDE.md
